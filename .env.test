# =============================================================================
# NeuronGuard AG Agents Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# =============================================================================
# APP SETTINGS
# =============================================================================
ENV=development           # development | production
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# =============================================================================
# LLM — DEV (Featherless.ai — OpenAI-compatible)
# =============================================================================
# CrewAI uses LiteLLM under the hood. Featherless is OpenAI-compatible.
# Format en modelo: openai/deepseek-ai/DeepSeek-V4-Pro

FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Modelos disponibles (4 slots cada uno — solo 1 activo a la vez)
# deepseek-ai/DeepSeek-V4-Pro    → análisis técnico profundo
# moonshotai/Kimi-K2-Thinking    → razonamiento complejo
# moonshotai/Kimi-K2.6           → consultas estándar rápidas
# zai-org/GLM-5.1                → multilingüe, docentes

FEATHERLESS_MODEL_DEEP=deepseek-ai/DeepSeek-V4-Pro
FEATHERLESS_MODEL_STANDARD=moonshotai/Kimi-K2.6
FEATHERLESS_MODEL_TEACHER=zai-org/GLM-5.1

# Embeddings (siempre activo — 1 slot)
FEATHERLESS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# =============================================================================
# LLM — TOKAINE (data loader, qwen-flagship — OpenAI-compatible)
# =============================================================================
TOKAINE_API_KEY=your_tokaine_api_key_here
TOKAINE_BASE_URL=https://api.tokaine.co
TOKAINE_MODEL=qwen-flagship

# =============================================================================
# LLM — PRODUCCIÓN (OpenRouter)
# =============================================================================
# Solo se usan cuando ENV=production
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos de producción
OPENROUTER_MODEL_DEEP=anthropic/claude-fable-5       # análisis profundo, executive report
OPENROUTER_MODEL_STANDARD=openai/gpt-5.5              # consultas técnicas estándar
OPENROUTER_MODEL_TEACHER=openai/gpt-5.5               # agentes docentes

# HTTP Referer requerido por OpenRouter
OPENROUTER_SITE_URL=https://neuronguard.site
OPENROUTER_APP_NAME=NeuronGuard AG Agents

# =============================================================================
# QDRANT — Vector Database
# =============================================================================
QDRANT_URL=https://vectordatarag.neuronguard.site
QDRANT_API_KEY=3lpw1xrylsoelgbu9wvgr7polxgtv1cu
QDRANT_COLLECTION_DIM=1024
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.7

# =============================================================================
# REDIS — Conversation History
# =============================================================================
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=2
# DB 0: Guardrails cache
# DB 1: Orchestrator
# DB 2: AG Agents (este proyecto)

REDIS_HISTORY_TTL=86400    # 24h en segundos
REDIS_HISTORY_MAX=20       # máximo de mensajes por sesión

# =============================================================================
# INSFORGE — PostgREST Database
# =============================================================================
INSFORGE_URL=https://neurona-aplication-backend.shyntai.com
INSFORGE_API_KEY=your_insforge_api_key_here
# Tablas: ag_agents, ag_sessions, ag_usage_logs, ag_knowledge, ag_collections

# =============================================================================
# MCP SKILLS SERVER
# =============================================================================
MCP_SKILLS_URL=https://mcp-skills.shyntai.com
MCP_SKILLS_API_KEY=your_mcp_skills_api_key_here
MCP_SKILLS_LIMIT=15        # máximo de skills por agente por llamada

# =============================================================================
# N8N — Webhook de retorno (para notificaciones al panel)
# =============================================================================
N8N_WEBHOOK_BASE=https://ng-automation-llm.neuronguard.site/webhook
N8N_API_KEY=your_n8n_api_key_here

# =============================================================================
# SECURITY
# =============================================================================
# API Key que el panel admin debe enviar en x-api-key header
AG_GATEWAY_API_KEY=your_strong_random_key_here

# Máximo de caracteres por mensaje
MAX_MESSAGE_LENGTH=5000
